# ============================================================================
# .htaccess — AnonimizaPDF (raíz del subdominio)
# ============================================================================

Options -Indexes

# ----- Cache duration -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # Librerías vendorizadas (pdf.js, jsPDF, Tesseract): cambian de nombre si se
  # actualizan, así que se pueden cachear largo sin cache-buster.
  ExpiresByType application/wasm "access plus 1 year"
</IfModule>

# ----- Cache-Control headers -----
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff|woff2|wasm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- MIME types correctos (pdf.js necesita .mjs y .wasm) -----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType application/wasm .wasm
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# El .gz de los datos de idioma de Tesseract NO debe recomprimirse:
# ya está comprimido y el propio Tesseract lo descomprime.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
  <FilesMatch "\.gz$">
    SetEnv no-gzip 1
  </FilesMatch>
</IfModule>

# ----- Nunca sirvas configuraciones ni claves si terminan aquí por error -----
<FilesMatch "(^|_)(api_key|config|secret)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "usuarios\.json$">
  Require all denied
</FilesMatch>
